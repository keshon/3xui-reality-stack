# secrets and generated state - never commit
.env
users.txt
CLIENT-CREDENTIALS.txt
CLIENT-LINKS.txt
handout/
awg/

# runtime data
traefik/data/
traefik/dynamic/tls.yml
shared/certs/
xui/db/
# The decoy site is per-deployment on purpose. If every install served the
# same pages, the pages themselves would identify the install - the one thing
# the decoy exists to prevent. decoy/site.example/ is the seed; the real one
# is yours and is never committed.
decoy/site/

# rendered from templates
hysteria/config.yaml

# scratch / research material, not part of the stack
tmp/

# python
__pycache__/
*.pyc

# editors / os
*.swp
*~
.DS_Store

# written by scripts/routing.py before it changes anything
xray-template.backup.json
