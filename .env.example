# ─── copy to .env and fill in, then run ./install.sh ────────────────────────
TZ=Etc/UTC

# ─── DOMAINS ────────────────────────────────────────────────────────────────
# The registered zone. One wildcard cert (*.BASE_DOMAIN) is issued for it.
BASE_DOMAIN=example.com

# PUBLIC_DOMAIN is the ONE hostname clients ever touch:
#   * the Reality serverName, the trojan Host header, the Hysteria2 SNI, and
#     the MTProto FakeTLS fronting domain
#   * it MUST have an A record pointing at this server
#   * it serves a real website, so probing it looks like an ordinary host
# Pick something boring and plausible. A generated-looking name such as
# "a7f2-x9k" is itself a signal.
PUBLIC_DOMAIN=www.example.com

# The admin surface, on a hostname your users never see. Needs an A record too.
PANEL_DOMAIN=ops.example.com

# Secret path prefixes (must start with '/'). install.sh generates them if left
# blank, and writes them back into this file.
PANEL_PATH=
SUB_PATH=
JSON_PATH=

# Path for the trojan tunnel, served under PUBLIC_DOMAIN. Make it look like
# something a real site would serve.
TROJAN_PATH=/assets/stream

# ─── REALITY ────────────────────────────────────────────────────────────────
# Which browser's ClientHello Reality clients imitate (uTLS). Published to
# clients in the subscription as `fp=`; the server does not check it.
#
# "chrome" blends in best in principle, but current Chrome sends a
# post-quantum key share that makes the ClientHello ~1800 bytes - two TCP
# segments. A middlebox that forwards the first segment and drops the second
# leaves the handshake half-delivered forever: the connection hangs with no
# RST and no log entry anywhere, while every other lane on the same host and
# port keeps working. If Reality alone is dead on one network and fine on
# another, that is the shape of it - try "safari" or "ios", which have no
# post-quantum key share and fit in one segment.
#   chrome firefox safari ios android edge 360 qq random randomized
REALITY_FINGERPRINT=chrome

# ─── ROLE ───────────────────────────────────────────────────────────────────
# standalone = one server, current behaviour (default, unchanged).
# master     = central panel: owns users.txt and serves the subscriptions;
#              behaves like standalone, plus nodes register here (stage 2+).
# node       = expendable traffic node: keeps no users and serves no
#              subscriptions. install.sh skips users.txt, lane provisioning,
#              consolidation and subscription URLs, but still issues the
#              wildcard cert and brings up Traefik, decoy, Xray and the panel.
#              Lanes and clients arrive later from the master via its API.
ROLE=standalone

# Bearer token the master uses against THIS panel's API (node role only).
# install.sh mints it via scripts/mint-node-token.py (3x-ui scoped API tokens:
# name unique, scope "node-sync", expiresAt 0 = never; plaintext is returned
# only once at creation) and writes it back here. A node-sync token reaches
# exactly the node-sync allowlist, not the admin surface. Keep this file 600.
NODE_API_TOKEN=

# ─── ACCOUNTS ───────────────────────────────────────────────────────────────
# One account per person. Each gets a single client record attached to every
# lane, and one subscription URL that emits all of them.
#
# Two ways to say who. A users.txt file (one name per line, '#' comments) wins
# if it exists; otherwise this comma-separated list is used. install.sh writes
# the resolved list back into USERS= either way, so the two never disagree.
#   cp users.txt.example users.txt && $EDITOR users.txt
#
# Names: a-z, 0-9 and '_' only, up to 24 chars. No '-' - client emails are
# namespaced per lane as r-<name>/t-<name>/h-<name> and the consolidation step
# splits on the first '-' to recover the person.
USERS=alice,bob,carol

# Where to look for the list. Relative to the repo root. Set empty to ignore
# any users.txt and use USERS= above only.
USERS_FILE=users.txt

# Lanes each account is attached to. Order does not matter.
LANES=vless-reality,trojan-httpupgrade,hysteria2,mtproto,amneziawg

# Optional per-account limits enforced by scripts/reconcile-clients.py
# (0 = no limit, the default). Applied on creation; on existing accounts
# enforced only when non-zero and different, so re-runs stay no-ops.
# USER_LIMIT_GB: total traffic per account in GiB.
# USER_EXPIRY_DAYS: account lifetime in days from creation.
USER_LIMIT_GB=0
USER_EXPIRY_DAYS=0

# ─── PORTS ──────────────────────────────────────────────────────────────────
# 443/tcp Reality, 443/udp Hysteria2, 80/tcp ACME. These are the other two.
MTPROTO_PORT=8443

# NOT 51820. That is WireGuard's default port and the one blocklists cover
# first - the payload is obfuscated, but the port number is not, and it is the
# only part of an AmneziaWG flow that still says "WireGuard". Mobile carriers
# in particular drop it. Any unremarkable high port will do; change this one so
# every deployment does not share it either.
AWG_PORT=28844
AWG_SUBNET=10.8.1.0

# Tunnel MTU. Written into every client config and used by the server's own
# interface. Blank means 1280 - deliberately conservative: it is the IPv6
# minimum, so every path carries it.
#
# Plain WireGuard budgets 60 bytes of overhead and so defaults to 1420 on a
# 1500-byte link. AmneziaWG adds up to ~64 more (S4 transport junk, content
# padding, random trailers), and access networks are rarely 1500 to begin with.
# Set it too high and nothing fails outright - small requests fit, large ones
# stall and retry, and the tunnel merely feels slow and fragile.
AWG_MTU=1280

# ─── ACME ───────────────────────────────────────────────────────────────────
LETSENCRYPT_EMAIL=you@example.com

# dns  = DNS-01 via Cloudflare, issues *.BASE_DOMAIN as ONE wildcard cert.
#        STRONGLY preferred: every certificate you issue is published in
#        Certificate Transparency logs, so per-hostname certs let anyone
#        enumerate your whole infrastructure at crt.sh. A wildcard leaks only
#        the zone name, and lets you rotate the tunnel hostname in seconds
#        without creating a new CT entry.
# http = HTTP-01 per hostname. Only if you cannot use a supported DNS provider.
ACME_MODE=dns

# Cloudflare API token, scoped Zone:DNS:Edit on this zone only.
# dash.cloudflare.com -> My Profile -> API Tokens -> Create -> Edit zone DNS
CF_DNS_API_TOKEN=

# Basename of the cert files written into shared/certs/.
#   ACME_MODE=dns  -> the zone:      example.com
#   ACME_MODE=http -> the hostname:  www.example.com
CERT_BASENAME=example.com

# ─── ADMIN ──────────────────────────────────────────────────────────────────
# Left blank, install.sh generates these and prints them once.
PANEL_USER=
PANEL_PASS=

# ─── docker network ─────────────────────────────────────────────────────────
PROXY_SUBNET=172.28.0.0/16

# ─── OPS (scripts/backup.sh, scripts/healthcheck.sh) ────────────────────────
# How many newest backup archives to keep (rotation).
BACKUP_KEEP=7
# Where to keep them. Add your own path; it stays out of git (see .gitignore).
BACKUP_DIR=backups
# Optional Telegram alert for healthcheck.sh failures (both or neither).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
